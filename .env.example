# --- pstack version ที่ pin (อ่าน CHANGELOG ของ pstack ก่อนอัปเกรดเสมอ) ---
PSTACK_REF=v0.2.0

# --- pstack settings ---
PSTACK_DEBUG=true
PSTACK_SECRET_KEY=change-me-to-a-long-random-string
PSTACK_DATABASE_URL=postgresql+asyncpg://care:care@db:5432/care
PSTACK_REDIS_URL=redis://redis:6379/0

# โมดูลที่เปิดใช้ — ลำดับไม่สำคัญ (loader จัดตาม depends ให้เอง)
#   users                       : ของ pstack (auth/RBAC)
#   ap_*                        : platform conformance layer (ADR-0003)
#   care_*                      : care domain
PSTACK_MODULES=users,ap_tenancy,ap_audit,ap_policy,care_patient,care_escalation,care_routine,care_medication,care_journal,care_appointment,care_orientation,line_oa,ai_agent,care_line
# โมดูลที่ยังไม่ได้ทำ (ดู architecture/team-plan.md) — ใส่ชื่อที่ยังไม่มีจะ boot ไม่ผ่าน:
#   care_careplan, care_activity, care_inventory, care_home, care_safety, ap_approval
#
# LINE: ตั้ง webhook เป็น https://<โดเมน>/api/line/webhook/<LINE channel ID>
#       และตั้ง agent_enabled = false ตอนสร้าง channel (ADR-0008)

# addons ของ pstack + ของ repo นี้
#   ใน Docker : addons,care_addons  (pstack ถูก clone เข้า image แล้ว)
#   dev บนเครื่อง : ../pstack/addons,care_addons
PSTACK_ADDONS_PATHS=addons,care_addons

PSTACK_ADMIN_EMAIL=admin@example.com
PSTACK_ADMIN_PASSWORD=admin

# ai_agent / line_oa (เปิดใช้เมื่อถึง M4 — ดู architecture/team-plan.md)
ANTHROPIC_API_KEY=

# --- care platform settings ---
# timezone ที่ใช้ตีความ routine/appointment ของ tenant ที่ไม่ได้ตั้งค่าเอง
CARE_DEFAULT_TIMEZONE=Asia/Bangkok

# พอร์ตที่เปิดบนเครื่อง (ถ้าชนกับของเดิมให้เปลี่ยน) — deploy หลัง Caddy กลางให้ลบ ports: ใน compose
APP_PORT=8000

# --- postgres container ---
DB_NAME=care
DB_USER=care
DB_PASSWORD=care
