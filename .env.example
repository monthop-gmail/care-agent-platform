# --- pstack version ที่ pin (อ่าน CHANGELOG ของ pstack ก่อนอัปเกรดเสมอ) ---
# (ห้ามใส่คอมเมนต์ต่อท้ายบรรทัดนี้ — CI ตัดค่าด้วย cut -d= -f2 จะได้คอมเมนต์ติดมาด้วย)
PSTACK_REF=v0.5.1

# --- pstack settings ---
# 🔒 production ต้องเป็น false — debug=true ทำให้ (1) กฎคีย์อ่อนกลายเป็นแค่คำเตือน
#    ไม่ใช่การปฏิเสธการบูต และ (2) /docs /redoc /openapi.json เปิดสาธารณะ (pstack v0.4.0)
PSTACK_DEBUG=false
# 🔒 pstack v0.4.0+ **ปฏิเสธการบูต** ถ้าคีย์สั้นกว่า 32 ตัวหรือเป็นค่าที่เดาได้
#    (ค่า placeholder เดิมของไฟล์นี้อยู่ในรายการค่าที่เดาได้แล้ว จึงใช้ไม่ได้อีก)
#    สุ่มด้วย: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
PSTACK_SECRET_KEY=
PSTACK_DATABASE_URL=postgresql+asyncpg://care:care@db:5432/care
PSTACK_REDIS_URL=redis://redis:6379/0

# โมดูลที่เปิดใช้ — ลำดับไม่สำคัญ (loader จัดตาม depends ให้เอง)
#   users                       : ของ pstack (auth/RBAC)
#   tenancy                     : control plane ของ kernel (pstack v0.3.0)
#   ap_*                        : platform conformance layer (ADR-0003)
#   care_*                      : care domain
PSTACK_MODULES=users,tenancy,ap_consent,ap_audit,ap_policy,ap_approval,care_patient,care_escalation,care_routine,care_medication,care_journal,care_appointment,care_orientation,care_careplan,care_activity,care_inventory,care_home,care_safety,care_organization,care_orchestrator,line_oa,ai_agent,care_line
# โมดูลที่ยังไม่ได้ทำ (ดู architecture/team-plan.md) — ใส่ชื่อที่ยังไม่มีจะ boot ไม่ผ่าน:
#   (ยังไม่มี — M6 connector ข้ามองค์กร)
#
# LINE: ตั้ง webhook เป็น https://<โดเมน>/api/line/webhook/<LINE channel ID>
#       และตั้ง agent_enabled = false ตอนสร้าง channel (ADR-0008)

# addons ของ pstack + ของ repo นี้
#   ใน Docker : addons,care_addons  (pstack ถูก clone เข้า image แล้ว)
#   dev บนเครื่อง : ../pstack/addons,care_addons
PSTACK_ADDONS_PATHS=addons,care_addons

PSTACK_ADMIN_EMAIL=admin@example.com
# 🔒 v0.4.1+ บังคับ >=12 ตัวและห้ามเป็นค่าที่เดาได้ ("admin" เดิมใช้ไม่ได้แล้ว)
#    ค่านี้ใช้ตอน**สร้าง admin ครั้งแรก**เท่านั้น — แก้ทีหลังต้องใช้ CLI:
#      docker compose exec app python cli.py set-password admin@example.com
PSTACK_ADMIN_PASSWORD=

# รันหลัง reverse proxy (Caddy/nginx)? ต้องตั้งเป็น IP ของ proxy ไม่งั้น rate limit
# ต่อ IP ของ v0.4.0 จะนับทุก request เป็น IP เดียว = กลายเป็นลิมิตรวมของทั้งระบบ
# (ตั้ง PSTACK_LOGIN_RATE_LIMIT_PER_IP=0 เพื่อปิด rate limit ถ้าไม่ต้องการ)
# FORWARDED_ALLOW_IPS=

# ai_agent / line_oa (เปิดใช้เมื่อถึง M4 — ดู architecture/team-plan.md)
ANTHROPIC_API_KEY=

# --- care platform settings ---
# timezone ที่ใช้ตีความ routine/appointment ของ tenant ที่ไม่ได้ตั้งค่าเอง
CARE_DEFAULT_TIMEZONE=Asia/Bangkok

# พอร์ตที่เปิดบนเครื่อง (ถ้าชนกับของเดิมให้เปลี่ยน) — deploy หลัง Caddy กลางให้ลบ ports: ใน compose
APP_PORT=8000

# --- postgres container ---
DB_NAME=care

# role ที่ "แอป" ใช้ต่อ — ต้องไม่ใช่ superuser ไม่งั้น RLS ถูก bypass ทั้งหมด
# (FORCE ROW LEVEL SECURITY คุมได้แค่ table owner ไม่ได้คุม superuser)
# ค่านี้ต้องตรงกับ user ใน PSTACK_DATABASE_URL ด้านบน
DB_USER=care
DB_PASSWORD=care

# superuser สำหรับ bootstrap ของ container เท่านั้น — แอปไม่ได้ใช้ role นี้
# image postgres สร้าง POSTGRES_USER เป็น superuser เสมอ จึงต้องแยกออกจาก DB_USER
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=change-me-too
